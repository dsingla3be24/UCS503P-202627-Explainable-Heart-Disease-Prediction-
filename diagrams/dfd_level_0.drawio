<mxfile host="app.diagrams.net">
  <diagram name="Level 0 DFD (Context Diagram)" id="DFD_Level_0_Context">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title_0" parent="1" vertex="1"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#111111;fontStyle=1;"
          value="&lt;b&gt;Level 0 Data Flow Diagram (Context Diagram)&lt;br&gt;CardioAI – Heart Disease Prediction System&lt;/b&gt;">
          <mxGeometry x="234" y="25" width="700" height="50" as="geometry" />
        </mxCell>

        <!-- External Entity: Clinician -->
        <mxCell id="ent_clinician" parent="1" vertex="1"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=0;strokeWidth=2;"
          value="&lt;b&gt;Clinician&lt;/b&gt;">
          <mxGeometry x="60" y="340" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- External Entity: Database Administrator -->
        <mxCell id="ent_dba" parent="1" vertex="1"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=0;strokeWidth=2;"
          value="&lt;b&gt;Database&lt;br&gt;Administrator&lt;/b&gt;">
          <mxGeometry x="60" y="640" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- External Entity: UCI Cleveland Dataset -->
        <mxCell id="ent_dataset" parent="1" vertex="1"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;rounded=0;strokeWidth=2;"
          value="&lt;b&gt;UCI Cleveland&lt;br&gt;Dataset&lt;/b&gt;">
          <mxGeometry x="940" y="180" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- External Entity: ACC/AHA Clinical Guidelines -->
        <mxCell id="ent_guidelines" parent="1" vertex="1"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;rounded=0;strokeWidth=2;"
          value="&lt;b&gt;ACC/AHA Clinical&lt;br&gt;Guidelines&lt;/b&gt;">
          <mxGeometry x="940" y="520" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- Process 0: CardioAI Heart Disease Prediction System -->
        <mxCell id="proc_0" parent="1" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=13;align=center;verticalAlign=middle;strokeWidth=2;"
          value="&lt;b&gt;0&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CardioAI&lt;br&gt;Heart Disease&lt;br&gt;Prediction&lt;br&gt;System&lt;/b&gt;">
          <mxGeometry x="460" y="270" width="250" height="210" as="geometry" />
        </mxCell>

        <!-- ================= DATA FLOWS ================= -->

        <!-- 1. Clinician -> Process 0: Patient Clinical Data -->
        <mxCell id="flow_clin_in1" parent="1" edge="1" source="ent_clinician" target="proc_0"
          style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0.03;entryY=0.3;"
          value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Patient Clinical Data&lt;br&gt;(13 Features)&lt;/font&gt;">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- 2. Clinician -> Process 0: Search Query -->
        <mxCell id="flow_clin_in2" parent="1" edge="1" source="ent_clinician" target="proc_0"
          style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"
          value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Search Query&lt;/font&gt;">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- 3. Process 0 -> Clinician: Risk Prediction & XAI Visualizations -->
        <mxCell id="flow_clin_out1" parent="1" edge="1" source="proc_0" target="ent_clinician"
          style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;rounded=0;labelBackgroundColor=#ffffff;exitX=0.03;entryX=1;exitY=0.7;entryY=0.75;"
          value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Risk Prediction &amp;amp;&lt;br&gt;XAI Visualizations&lt;/font&gt;">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- 4. Process 0 -> Clinician: PDF Report & Clinical Guidance -->
        <mxCell id="flow_clin_out2" parent="1" edge="1" source="proc_0" target="ent_clinician"
          style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.15;exitY=0.88;entryX=0.5;entryY=1;"
          value="&lt;font style=&quot;font-size: 10px;&quot;&gt;PDF Report &amp;amp;&lt;br&gt;ACC/AHA Recommendations&lt;/font&gt;">
          <mxGeometry as="geometry">
            <Array as="points">
              <mxPoint x="498" y="470" />
              <mxPoint x="135" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 5. Process 0 -> Clinician: Patient History Results -->
        <mxCell id="flow_clin_out3" parent="1" edge="1" source="proc_0" target="ent_clinician"
          style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.12;exitY=0.12;entryX=0.5;entryY=0;"
          value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Patient History Results&lt;/font&gt;">
          <mxGeometry as="geometry">
            <Array as="points">
              <mxPoint x="490" y="280" />
              <mxPoint x="135" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 6. UCI Cleveland Dataset -> Process 0: Training Data -->
        <mxCell id="flow_dataset" parent="1" edge="1" source="ent_dataset" target="proc_0"
          style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;rounded=0;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.95;entryY=0.25;"
          value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Training Data&lt;br&gt;(303 Records)&lt;/font&gt;">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- 7. ACC/AHA Guidelines -> Process 0: Clinical Rules -->
        <mxCell id="flow_guidelines" parent="1" edge="1" source="ent_guidelines" target="proc_0"
          style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;rounded=0;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.95;entryY=0.75;"
          value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Clinical Rules &amp;amp;&lt;br&gt;Risk Thresholds&lt;/font&gt;">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- 8. DBA -> Process 0: SQL Queries & Admin Commands -->
        <mxCell id="flow_dba_in" parent="1" edge="1" source="ent_dba" target="proc_0"
          style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;entryX=0.3;entryY=0.96;"
          value="&lt;font style=&quot;font-size: 10px;&quot;&gt;SQL Queries /&lt;br&gt;Admin Commands&lt;/font&gt;">
          <mxGeometry as="geometry">
            <Array as="points">
              <mxPoint x="360" y="661" />
              <mxPoint x="360" y="560" />
              <mxPoint x="535" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 9. Process 0 -> DBA: Query Results & Reports -->
        <mxCell id="flow_dba_out" parent="1" edge="1" source="proc_0" target="ent_dba"
          style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=1;entryY=0.7;"
          value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Query Results /&lt;br&gt;Reports&lt;/font&gt;">
          <mxGeometry as="geometry">
            <Array as="points">
              <mxPoint x="585" y="689" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
